# Oxylabs residential proxy settings.
# Fill these in your local .env. Do not commit real credentials.
OXYLABS_PROXY_SERVER=http://pr.oxylabs.io:7777
OXYLABS_PROXY_USERNAME=customer-USERNAME
OXYLABS_PROXY_PASSWORD=PASSWORD

# Alternative: single URL form. If set, this overrides username/password/server above.
# OXYLABS_PROXY_URL=http://customer-USERNAME-sessid-redditrun01-sesstime-10:PASSWORD@pr.oxylabs.io:7777

# Optional scraper tuning.
REDDIT_SCRAPER_OUTPUT=data/reddit_posts.jsonl
REDDIT_SCRAPER_RUN_DIR=data/runs
REDDIT_SCRAPER_BASE_URL=https://old.reddit.com
REDDIT_SCRAPER_MAX_POSTS=50
REDDIT_SCRAPER_PAGES=2
REDDIT_SCRAPER_NAV_TIMEOUT_MS=45000

# Optional benchmark critic settings.
# OPENCODE_API_KEY=your-opencode-api-key
OPENCODE_BASE_URL=https://opencode.ai/zen/go/v1
OPENCODE_MODEL=kimi-k2.6
